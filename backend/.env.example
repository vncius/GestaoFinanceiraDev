PORT=3100
CORS_ORIGIN=http://localhost:3101
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.wkpeyn1.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=gestao_financeira

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório
# longo, ex: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# SameSite do cookie de sessão (lax | strict | none). Default lax: em produção
# o frontend chama a API pelo proxy same-origin (/api) do Cloudflare Pages.
# Use none só se o frontend chamar o backend direto, em outro domínio.
# COOKIE_SAME_SITE=lax

# IP real do cliente atrás do proxy /api do Cloudflare Pages: mesmo valor
# configurado como PROXY_SHARED_SECRET no projeto do Cloudflare. Gere com
# openssl rand -base64 32. Sem ele, o IP registrado é o do Cloudflare.
# PROXY_SHARED_SECRET=
# Proxies confiáveis à frente do Express para X-Forwarded-For (Render: 1).
# TRUST_PROXY_HOPS=1

# OAuth Client ID do Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ─── Plataforma de IA (docs/architecture/ai-platform.md) ─────────────────────
# Provedor: "fake" (default; determinístico, sem rede — o assistente não
# funciona de verdade), "anthropic" ou "openai" (ambos exigem AI_API_KEY e
# AI_MODEL explícitos — ver create-ai-provider.ts).
AI_PROVIDER=fake
# Chave do provedor real (console.anthropic.com ou platform.openai.com,
# conforme AI_PROVIDER). Existe SOMENTE no backend; nunca commitar o valor
# real, nunca logar, nunca enviar ao frontend.
AI_API_KEY=
# Modelo — obrigatório para "anthropic"/"openai" (sem default: cada provedor
# tem seus próprios nomes de modelo).
# AI_PROVIDER=anthropic → AI_MODEL=claude-opus-4-8
# AI_PROVIDER=openai    → AI_MODEL=gpt-4o-mini (ou gpt-4o para mais qualidade)
# AI_MODEL=
# Limites opcionais (defaults em backend/src/modules/ai/ai.config.ts)
# AI_MAX_OUTPUT_TOKENS=1024
# AI_REQUEST_TIMEOUT_MS=45000
# AI_MAX_TOOL_ROUNDS=8
