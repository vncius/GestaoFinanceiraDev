PORT=3100
CORS_ORIGIN=http://localhost:3101
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.wkpeyn1.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=gestao_financeira

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório
# longo, ex: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# OAuth Client ID do Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Services ID da Apple (Apple Developer > Certificates, Identifiers & Profiles)
APPLE_CLIENT_ID=seu-services-id.exemplo.com
