{
  "name": "gestao-financeira-backend",
  "version": "1.0.0",
  "description": "Backend do sistema de gestão financeira",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "migrate:mongo": "tsx src/scripts/migrate-json-to-mongo.ts",
    "migrate:card-payment-account": "tsx src/scripts/migrate-card-payment-account.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "mongodb": "^7.5.0",
    "openai": "^6.46.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^4.1.10"
  }
}
