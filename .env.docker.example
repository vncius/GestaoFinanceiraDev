# Modelo das variáveis do docker-compose.yml. Copie para um arquivo FORA do
# projeto (ou para .env.docker, que o git ignora) e preencha com os valores de
# PRODUÇÃO. Suba com: docker compose --env-file CAMINHO/DO/ARQUIVO up -d --build
# Antes do primeiro login, confira a chave (ver README, "Rodando com Docker").

# Porta local do app: http://localhost:8080. Ela precisa estar em
# "Origens JavaScript autorizadas" do Client ID no Google Cloud Console.
APP_PORT=8080

MONGODB_URI=
MONGODB_DB_NAME=gestao_financeira

# Mesmo valor do Render: com outro, todos precisam logar de novo.
JWT_SECRET=
# Mesmo valor do Render, OBRIGATORIAMENTE: com outra chave os campos
# criptografados do banco ficam ilegíveis.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=

AI_PROVIDER=fake
AI_API_KEY=
# AI_MODEL=

# Exibidos na Política de Privacidade e nos Termos de Uso.
VITE_LEGAL_CONTROLLER_NAME=
VITE_LEGAL_CONTACT_EMAIL=
