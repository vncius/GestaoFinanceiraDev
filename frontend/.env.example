VITE_API_URL=http://localhost:3100
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Em produção (Cloudflare Pages), usar VITE_API_URL=/api para passar pelo proxy
# same-origin em functions/api/[[path]].ts (evita bloqueio de cookie de terceiro
# em navegadores mobile). A URL real do backend vai na env var API_ORIGIN,
# configurada no dashboard do Cloudflare Pages — não neste arquivo.
